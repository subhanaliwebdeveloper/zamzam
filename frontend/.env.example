# Set this to the deployed backend URL followed by /api, e.g. https://zamzam-api.vercel.app/api
VITE_API_URL=https://your-backend-app.vercel.app/api

# Optional: only set this when using a separate, persistent Socket.IO server.
# Vercel serverless functions do not support persistent Socket.IO connections.
# VITE_SOCKET_URL=https://your-persistent-socket-server.example.com
